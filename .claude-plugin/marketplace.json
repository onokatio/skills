{
  "name": "onokatio-plugins",
  "description": "外部スキルと MCP サーバーを参照する個人用 marketplace。",
  "owner": {
    "name": "onokatio"
  },
  "interface": {
    "displayName": "onokatio plugins"
  },
  "plugins": [
    {
      "name": "gh-stack",
      "description": "gh-stack で積み重ねたブランチと Pull Request を管理するスキル。",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/github/gh-stack.git",
        "path": "skills/gh-stack"
      },
      "skills": ["./"],
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Development"
    },
    {
      "name": "test-audit",
      "description": "テストの価値を確認し、重複や実装に依存したテストを監査するスキル。",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/openclaw/openclaw.git",
        "path": ".agents/skills/test-audit"
      },
      "skills": ["./"],
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Development"
    },
    {
      "name": "security-audit",
      "description": "セキュリティの相談やコードベースの脆弱性監査に使う Cloudflare のスキル。全工程の監査は明示的に依頼したときだけ実行し、その検証スクリプトに Node.js を使う。",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/cloudflare/security-audit-skill.git",
        "path": "skills/security-audit"
      },
      "skills": ["./"],
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Development"
    },
