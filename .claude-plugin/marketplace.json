    {
      "name": "bitwarden",
      "description": "Bitwarden 公式 MCP サーバーをローカルで起動するプラグイン。",
      "source": {
        "source": "url",
        "url": "https://github.com/bitwarden/mcp-server.git"
      },
      "strict": false,
      "mcpServers": {
        "bitwarden": {
          "command": "npx",
          "args": ["-y", "@bitwarden/mcp-server"]
        }
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
