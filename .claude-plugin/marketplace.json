      "source": {
        "source": "git-subdir",
        "url": "https://github.com/diegorv/claude-functions-hook.git",
        "path": "plugins/gh-ci-status",
        "ref": "main",
        "sha": "67840c696ef88405ceb42dc9ec95f3e3a7b90759"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
